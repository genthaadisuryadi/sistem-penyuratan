APP_NAME="Sistem Penyuratan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_penyuratan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Sistem Penyuratan ----
APP_TIMEZONE=Asia/Jakarta
# WAJIB diisi domain produksi sebelum menerbitkan surat sungguhan: URL ini dicetak ke dalam QR Code.
VERIFICATION_BASE_URL=${APP_URL}
ADMIN_LOGIN_PATH=masuk-admin
UPLOAD_MAX_KB=10240

INSTANSI_NAMA="Nama Instansi Anda"
INSTANSI_SINGKATAN="Instansi"
# Letakkan logo di folder public/ lalu isi namanya, mis. INSTANSI_LOGO=logo.png
INSTANSI_LOGO=
INSTANSI_LOGO_NAVBAR=
INSTANSI_LOGO_FOOTER=
INSTANSI_KONTAK=

# Akun superadmin pertama (dibaca oleh `php artisan db:seed`)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@instansi.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Di belakang Nginx/Cloudflare/load balancer isi dengan "*" atau daftar IP proxy.
# TRUSTED_PROXIES=
# Ghostscript (opsional, cadangan untuk PDF 1.5+). Kosongkan untuk deteksi otomatis.
GHOSTSCRIPT_BINARY=
